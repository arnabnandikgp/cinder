# Local Linux qualification toolchain, NOT an enclave image or release.
FROM docker.io/library/rust:1.97.1-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev=3.0.22-1~deb12u1 pkg-config=1.8.1-1 && rm -r /var/lib/apt/lists
RUN rustup component add rustfmt clippy
ENV CARGO_INCREMENTAL=0 CARGO_NET_OFFLINE=true RUSTUP_TOOLCHAIN=1.97.1
